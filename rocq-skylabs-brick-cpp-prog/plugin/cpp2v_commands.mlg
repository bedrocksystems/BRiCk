DECLARE PLUGIN "rocq-skylabs-brick-cpp-prog.plugin"

{
open Stdarg
open Ltac_plugin
open Procq.Prim

let pr_cpp_string _ _ _ (s : string) =
  Pp.(str "cpp:{{" ++ fnl () ++ str s ++ fnl () ++ str "}}")

let pr_cpp_flags _ _ _ flags =
  match flags with
  | None -> Pp.str ""
  | Some s -> Pp.(str "flags \"" ++ str s ++ str "\"")

let rec strip_each ch str n =
  if n < String.length str && str.[n] = ch then
    strip_each ch str (n + 1)
  else
    String.(sub str n (length str - n - n))

let strip_braces str =
  if String.length str = 0 then str
  else if str.[0] = '\123' then strip_each '\123' str 1
  else if str.[0] = '(' then strip_each '(' str 1
  else if str.[0] = '[' then strip_each '[' str 1
  else str
}

ARGUMENT EXTEND cpp_string PRINTED BY { pr_cpp_string }
END

GRAMMAR EXTEND Gram GLOBAL: cpp_string;
cpp_string : FIRST [
  [ s = QUOTATION "cpp:" -> { strip_braces s } ]
];
END

ARGUMENT EXTEND cpp_flags TYPED AS string option PRINTED BY { pr_cpp_flags }
| [ "flags" string(flags) ] -> { Some flags }
| [ ] -> { None }
END

VERNAC COMMAND EXTEND Cpp CLASSIFIED AS SIDEFF
| #[ atts = Cpp2v.attributes ]
  [ "cpp.prog" ident(name) "abi" constr(abi) "defns" constr_list(defns) ] ->
  { Cpp2v.cpp_command atts name (Some abi) defns }
| #[ atts = Cpp2v.attributes ]
  [ "cpp.prog" ident(name) "defns" constr_list(defns) ] ->
  { Cpp2v.cpp_command atts name None defns }
END

VERNAC COMMAND EXTEND CppProg CLASSIFIED AS SIDEFF
| #[ atts = Cpp2v.attributes ]
  [ "cpp.prog" ident(name) cpp_flags(flags) "prog" cpp_string(prog) ] ->
  { Cpp2v.cpp_command_prog atts name flags prog }
END
